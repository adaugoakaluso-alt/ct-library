# Copy this file to .env and fill in what you use. Never commit .env.
# On Streamlit Community Cloud, put the same names in the app's Secrets box instead.
# Every setting is optional. With none set, the app runs on CSV uploads and manual entry.

# Name shown in the browser tab and sidebar, such as: AI Edge content reporting
APP_TITLE=

# Where your real CSVs are saved, relative to the repo root.
AI_EDGE_DATA_DIR=data

# Buffer: pulls Instagram and LinkedIn posts with likes, comments, shares, saves, views and reach.
# API key: https://publish.buffer.com/settings/api (only the organization owner can create one).
BUFFER_API_KEY=
# Organization and channel ids: Buffer's API Explorer, or ask Claude to look them up through the Buffer connector.
BUFFER_ORGANIZATION_ID=
# Comma-separated: the Instagram channel id and the LinkedIn channel id.
BUFFER_CHANNEL_IDS=

# ManyChat through Google Sheets: the "Publish to web" CSV link of the sheet your ManyChat flows log clicks to.
MANYCHAT_SHEET_CSV_URL=

# ManyChat API key (Settings > API in ManyChat). Reserved for the ManyChat API connector, which is not built yet.
MANYCHAT_API_KEY=
