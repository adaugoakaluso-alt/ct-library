# Copy this file to .env and fill in what you use. Never commit .env.
# On Streamlit Community Cloud, put the same names in the app's Secrets box instead.
# Every setting is optional. With none set, the app runs on CSV uploads and manual entry.
#
# One brand per copy: use the names below as they are.
# Several brands in one copy: put the brand id, in capitals with _ for -, in front of a
# setting to make it apply to that brand only. For brands/travel-noire.toml:
#   TRAVEL_NOIRE_BUFFER_API_KEY=...
#   TRAVEL_NOIRE_BUFFER_CHANNEL_IDS=...
# A brand's own setting wins. A brand without one uses the plain name.

# Brand the app opens on: a file name in brands/ without .toml, such as ai-edge.
BRAND=

# Overrides the title in the brand file (browser tab and sidebar).
APP_TITLE=

# Where real CSVs are saved, relative to the repo root. Each brand gets a folder inside it.
DATA_DIR=data

# Buffer: pulls posts with likes, comments, shares, saves, views and reach.
# API key: https://publish.buffer.com/settings/api (only the organization owner can create one).
BUFFER_API_KEY=
# Organization and channel ids: Buffer's API Explorer, or ask Claude to look them up through the Buffer connector.
BUFFER_ORGANIZATION_ID=
# Comma-separated Buffer channel ids. Posts are filed under the brand channel on the same platform.
# If a brand has two channels on one platform, say which is which with id:channel, for example
#   BUFFER_CHANNEL_IDS=abc123:instagram,def456:tn-plus-instagram,ghi789
BUFFER_CHANNEL_IDS=

# ManyChat through Google Sheets: the "Publish to web" CSV link of the sheet your ManyChat flows log clicks to.
MANYCHAT_SHEET_CSV_URL=
# Channel the ManyChat clicks belong to. Defaults to the brand's first Instagram channel.
MANYCHAT_CHANNEL=

# ManyChat API key (Settings > API in ManyChat). Reserved for the ManyChat API connector, which is not built yet.
MANYCHAT_API_KEY=
